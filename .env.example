# 仅作为 Windows 凭据管理器不可用时的备用方案。复制为 .env 后填写，切勿提交。
XR_DEEPSEEK_API_KEY=
XR_TAVILY_API_KEY=
XR_IMAGE_API_KEY=
# 可选：也可在设置页填写；保存后的图像设置优先于这些默认值。
XR_IMAGE_GENERATION_ENABLED=false
XR_IMAGE_BASE_URL=
XR_IMAGE_MODEL=
XR_IMAGE_TIMEOUT_SECONDS=180
XR_DEEPSEEK_MODEL=deepseek-v4-flash
XR_HOST=127.0.0.1
XR_PORT=8765
